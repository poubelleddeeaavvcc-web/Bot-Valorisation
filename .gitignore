# Personal financial data - never commit
data/portfolio_backup*.json
portfolio/*.json
results/portfolio_vs_screener.csv
__pycache__/
*.pyc

# Gmail OAuth credentials for newsletter_digest.py (local testing only -- CI uses repo
# secrets GMAIL_REFRESH_TOKEN/GMAIL_CLIENT_ID/GMAIL_CLIENT_SECRET instead)
.env

# intermediate download artifacts (extracted CSVs are what's used)
data/factors/*.zip

# backtest_momentum_proxy.py's raw price/FX download caches -- regenerated on demand
# (script re-downloads if missing), 30MB+ and not needed to interpret the results it
# produces (summary_proxy.csv, equity_curve_proxy.csv, per-bot trades/open CSVs)
results/backtest/price_panel_daily_cache.csv
results/backtest/fx_daily_cache.csv

# backtest_pit_replay.py's extracted git-history snapshot cache -- 500MB+, and by
# definition regenerable any time straight from this repo's own git history
# (extract_snapshots() re-extracts anything missing), so committing it would just be
# duplicating history the repo already has, at 500x the size
results/backtest_pit/snapshots/

# scoped to a single CI job's filesystem lifetime (see fetch_cache.fetch_one's docstring) --
# deliberately never committed, would just be stale-on-arrival for the next job/run anyway
results/screener/run_fetch_cache.json

